<?xml version="1.0" encoding="utf-8"?>
<!--
  Three tabs like in DumberKit Contacts, switched with ←/→ (icons in the bottom bar): the calculator, the unit
  converter and the settings. Calculator: the history like a paper tape (oldest on top, ↑/↓ go through it), under it
  the expression being typed in big digits, the result preview and a line with the key hints.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.fossify.math.activities.MainActivity">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/main_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/app_launcher_name"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/main_tabs_page_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <FrameLayout
        android:id="@+id/main_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/main_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_history" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/history_placeholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alpha="0.6"
            android:gravity="center"
            android:padding="@dimen/activity_margin"
            android:text="@string/dpad_calculator_empty"
            android:textSize="@dimen/normal_text_size"
            android:visibility="gone" />

        <View
            android:id="@+id/main_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="@android:color/darker_gray" />

        <TextView
            android:id="@+id/expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:layout_marginBottom="@dimen/medium_margin"
            android:gravity="end|center_vertical"
            android:maxLines="2"
            android:minHeight="@dimen/dpad_expression_min_height"
            android:paddingStart="@dimen/activity_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:textSize="@dimen/dpad_expression_text_size"
            tools:text="1 234,5 + 3 × 4" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:paddingBottom="@dimen/small_margin"
            android:visibility="gone"
            android:paddingStart="@dimen/activity_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:textSize="@dimen/dpad_preview_text_size"
            tools:text="Neúplný príklad" />


    </LinearLayout>

    <include
        android:id="@+id/unit_types_page"
        layout="@layout/page_unit_types"
        android:visibility="gone" />

    <include
        android:id="@+id/settings_page"
        layout="@layout/page_settings"
        android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/main_tabs_holder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dpad_tabs_height"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        app:tabIndicator="@null"
        app:tabRippleColor="@null" />

    </LinearLayout>

    <!-- hold *: the palette of symbols over the whole screen -->
    <org.fossify.math.views.SymbolPalette
        android:id="@+id/symbol_palette"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
