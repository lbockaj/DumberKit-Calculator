<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compact versions of Commons' settings row styles (same names override them), used by the settings and the color
      customization screens. Commons' rows are 52-60dp tall with big gaps above section titles, a bit too sparse for a
      480x640 screen, but with even padding so the text sits in the middle of the focus frame. The row content is centered so it sits in the middle of the focus frame.
    -->
    <style name="SettingsHolderSwitchStyle">
        <item name="android:paddingStart">@dimen/settings_label_start_margin</item>
        <item name="android:paddingTop">@dimen/dpad_settings_row_padding</item>
        <item name="android:paddingEnd">@dimen/settings_label_start_margin</item>
        <item name="android:paddingBottom">@dimen/dpad_settings_row_padding</item>
        <item name="android:minHeight">@dimen/dpad_settings_row_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/ripple_background</item>
    </style>

    <style name="SettingsHolderTextViewStyle">
        <item name="android:paddingStart">@dimen/settings_label_start_margin</item>
        <item name="android:paddingTop">@dimen/dpad_settings_row_padding</item>
        <item name="android:paddingEnd">@dimen/settings_label_start_margin</item>
        <item name="android:paddingBottom">@dimen/dpad_settings_row_padding</item>
        <item name="android:minHeight">@dimen/dpad_settings_row_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/ripple_background</item>
    </style>

    <style name="SettingsHolderTextViewOneLinerStyle" parent="@style/SettingsHolderTextViewStyle">
        <item name="android:paddingTop">@dimen/dpad_settings_row_padding</item>
        <item name="android:paddingBottom">@dimen/dpad_settings_row_padding</item>
        <item name="android:paddingEnd">@dimen/settings_label_start_margin</item>
        <item name="android:paddingStart">@dimen/settings_label_start_margin</item>
        <item name="android:background">@drawable/ripple_background</item>
    </style>

    <style name="MaterialSectionLabelStyle">
        <item name="android:layout_marginStart">@dimen/label_start_margin</item>
        <item name="android:paddingTop">@dimen/dpad_settings_section_padding</item>
        <item name="android:paddingBottom">@dimen/small_margin</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="SettingsSwitchStyle">
        <item name="android:background">@null</item>
        <item name="android:clickable">false</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
